# Copy to .env and fill in. Never commit .env.

# Which AI provider to use: openai or anthropic
LLM_PROVIDER=openai

# Key for the chosen provider (only the one you use is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the model (defaults: gpt-5.5 for openai, claude-opus-5-5 for anthropic)
LLM_MODEL=
# Reasoning effort: low | medium | high
LLM_EFFORT=high
